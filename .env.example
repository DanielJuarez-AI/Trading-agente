# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (SIN SECRETOS REALES)
# Copiar a .env para ejecución local. NUNCA exponer secretos en frontend / VITE_*
# ==============================================================================

# --- SEGURIDAD (SOLO SERVIDOR, NUNCA EXPONER EN REACT / VITE) ---
GATEWAY_API_KEY=replace_with_strong_random_secret_key
ADMIN_CONTROL_TOKEN=replace_with_admin_session_token

# --- QWEN (SWITCH DINÁMICO: API EXTERNA 14B  <->  LOCAL 6 GB VRAM 7B-Q4) ---
# Opciones QWEN_EXECUTION_MODE: "EXTERNAL_API" (por API remota) | "LOCAL_DEVICE" (en local <= 6GB VRAM)
QWEN_EXECUTION_MODE=EXTERNAL_API
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace_with_external_qwen_api_key
QWEN_MODEL_NAME=qwen2.5-14b-instruct
# Perfil Local optimizado para 6 GB VRAM disponible (sin contar Laya)
QWEN_LOCAL_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M
QWEN_LOCAL_VRAM_BUDGET_GB=6.0
QWEN_LOCAL_NUM_CTX=2048

# --- AGENTES LAYA #1 Y #2 (EJECUTADOS EN DISPOSITIVO LOCAL VÍA OLLAMA) ---
# [DISPOSITIVO LOCAL - OLLAMA /v1/systemone]: Laya #1 y Laya #2 corren 100% en local.
LAYA_EXECUTION_MODE=LOCAL_DEVICE
OLLAMA_BASE_URL=http://127.0.0.1:11434
LAYA_MODEL_NAME=laya:latest
LLM_TIMEOUT_SECONDS=30

# --- MERCADO PÚBLICO / MEXC (SIN CLAVES DE TRADING / ÓRDENES REALES DESHABILITADAS) ---
MEXC_PUBLIC_BASE_URL=https://api.mexc.com
DEFAULT_TICKER=BTC-USD
TRADING_SYMBOL=BTC-USD
CANDLE_INTERVAL=1d
ENABLE_REAL_TRADING=false

# --- PERFIL DE SIMULACIÓN Y RIESGO ---
# Opciones: "agent_paper" (50,000 capital, 0.0% fee) | "practice_backtest" (100,000 capital, 0.10% fee)
SIMULATION_PROFILE=agent_paper
SLIPPAGE_BPS=5
MAX_EXPOSURE_PCT=1.0
MAX_DAILY_LOSS_PCT=0.03
MAX_DATA_AGE_SECONDS=172800

# --- BASE DE DATOS ---
SQLITE_DB_PATH=data/trading_agent.db
